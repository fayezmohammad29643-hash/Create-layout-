{
  "schema_version": 4,
  "reference_system": "kufi",
  "upstream": {
    "repository": "https://github.com/quran-ws/qiraat-ayah-map.git",
    "ref": "main",
    "version": "0.1.0",
    "data_license": "CC BY 4.0",
    "tooling_license": "MIT",
    "source_policy": "Generate counting-system baselines from upstream source data. Never hand-copy or derive numbering by offset."
  },
  "exact_edition_source": {
    "repository": "https://github.com/quran-ws/quran-text",
    "ref": "main",
    "ayah_map_url": "https://raw.githubusercontent.com/quran-ws/quran-text/main/data/ayah-map.json",
    "expected_generated": "2026-09-08",
    "license_note": "Quran text is from KFGQPC and redistribution is subject to KFGQPC terms; the ayah map is source metadata for edition-level correspondence.",
    "purpose": "Exact printed-edition correspondence using shared word identity; not a replacement for Qiraat Ayah Map's counting-system evidence."
  },
  "resources": {
    "hafs": {
      "counting_system_associated_with_qari": "kufi",
      "project_sqlite_path": "input/hafs/quran.sqlite",
      "project_sqlite_ayah_count": 6236,
      "attachment_reference_system": "kufi",
      "mapping_exact_for_current_layout": true,
      "status": "exact"
    },
    "warsh": {
      "counting_system_associated_with_qari": "madani-last",
      "reference_upstream_edition": "quran-ws/quran-text Warsh current reference",
      "reference_upstream_ayah_count": 6214,
      "project_sqlite_path": "input/warsh/quran.sqlite",
      "project_sqlite_ayah_count": 6213,
      "attachment_reference_system": "kufi",
      "baseline_mapping_file": "mappings/by-counting-system/kufi-to-madani-last.json",
      "reverse_baseline_mapping_file": "mappings/by-counting-system/madani-last-to-kufi.json",
      "mapping_exact_for_current_layout": true,
      "status": "edition_exact_override",
      "mapping_file": "mappings/by-edition/warsh-6213-to-hafs.json",
      "reverse_mapping_file": "mappings/by-edition/hafs-to-warsh-6213.json",
      "edition_override": "data/ayah_mapping/edition-overrides/warsh-6213.json"
    },
    "qalun": {
      "counting_system_associated_with_qari": "madani-last",
      "reference_upstream_edition": "quran-text Qalun current verified edition",
      "reference_upstream_ayah_count": 6214,
      "project_sqlite_path": "input/qalun/quran.sqlite",
      "project_sqlite_ayah_count": 6214,
      "attachment_reference_system": "kufi",
      "exact_edition_source": "quran-text",
      "exact_edition_key": "qalun",
      "mapping_file": "mappings/by-edition/qalun-6214-to-hafs.json",
      "reverse_mapping_file": "mappings/by-edition/hafs-to-qalun-6214.json",
      "mapping_exact_for_current_layout": true,
      "status": "exact_edition_source"
    },
    "douri": {
      "counting_system_associated_with_qari": "basri",
      "printed_counting_system_baseline": "madani-first",
      "reference_upstream_edition": "quran-text Douri UthmanicDouri_V20",
      "reference_upstream_ayah_count": 6217,
      "project_sqlite_path": "input/douri/quran.sqlite",
      "project_sqlite_ayah_count": 6217,
      "attachment_reference_system": "kufi",
      "exact_edition_source": "quran-text",
      "exact_edition_key": "duri",
      "mapping_file": "mappings/by-edition/duri-6217-to-hafs.json",
      "reverse_mapping_file": "mappings/by-edition/hafs-to-duri-6217.json",
      "mapping_exact_for_current_layout": true,
      "status": "exact_edition_source",
      "reason": "The 2022 KFGQPC Douri V20 edition is represented by quran-text as a 6217-ayah printed edition measured to First Madinan. qiraat-ayah-map's generic First Madinan generated layer is a counting-system baseline; quran-text's edition-level ayah map is used for the exact printed-edition correspondence."
    }
  },
  "required_outputs": [
    "mappings/by-counting-system/kufi-to-madani-last.json",
    "mappings/by-counting-system/madani-last-to-kufi.json",
    "mappings/by-counting-system/kufi-to-madani-first.json",
    "mappings/by-counting-system/madani-first-to-kufi.json",
    "mappings/by-counting-system/kufi-to-basri.json",
    "mappings/by-counting-system/basri-to-kufi.json",
    "mappings/by-rawi/hafs-to-warsh.json",
    "mappings/by-rawi/warsh-to-hafs.json",
    "mappings/by-rawi/hafs-to-qalun.json",
    "mappings/by-rawi/qalun-to-hafs.json",
    "mappings/by-rawi/hafs-to-duri.json",
    "mappings/by-rawi/duri-to-hafs.json",
    "surah-counts/kufi.json",
    "surah-counts/madani-last.json",
    "surah-counts/madani-first.json",
    "surah-counts/basri.json",
    "rawis/hafs.json",
    "rawis/warsh.json",
    "rawis/qalun.json",
    "rawis/duri.json"
  ],
  "selection_policy": {
    "exact_consumable_mappings": [
      "hafs",
      "warsh-6213",
      "qalun-6214",
      "duri-6217"
    ],
    "counting_system_baselines": [
      "kufi",
      "madani-last",
      "madani-first",
      "basri"
    ],
    "note": "Use quran-text edition maps for exact Qalun 6214 and Douri 6217 correspondence, the local Warsh 6213 override for the project's older Warsh edition, and direct Hafs/Kufi numbering for Hafs. Qiraat Ayah Map is retained for counting-system evidence and provenance.",
    "never_use_numeric_offset": true
  },
  "edition_overrides": {
    "warsh_6213": "data/ayah_mapping/edition-overrides/warsh-6213.json"
  },
  "runtime_output": {
    "file": "miltazim_ayah_mapping.json",
    "relative_path": "output/ayah_mapping/miltazim_ayah_mapping.json",
    "consumer": "miltazim_flutter_app",
    "purpose": "The only ayah-mapping file required at runtime for Warsh 6213, Qalun 6214, and Douri 6217 to resolve Hafs/Kufi-keyed tafsir and attachments.",
    "direction": "edition-to-hafs"
  }
}
