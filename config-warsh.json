{
  "schema_version": 3,
  "layout_source": "pdf",
  "qiraah": "warsh",
  "font_family": null,
  "expected_pages": 604,
  "expected_surahs": 114,
  "pdf_region": {
    "top_margin_pt": 115,
    "bottom_margin_pt": 115,
    "line_y_tolerance_pt": 5.5
  },
  "tokenization": {
    "min_char_width_pt": 0.1,
    "lower_word_width_pt": 0.5,
    "upper_gap_threshold_pt": 0.05,
    "candidate_extra_tokens": 3,
    "max_tokens_per_line": 30,
    "visual_unit_y_tolerance_pt": 5.5,
    "max_visual_count_delta_for_correction": 3
  },
  "validation": {
    "review_on_marker_mismatch": true,
    "review_confidence_threshold": 0.7,
    "strict_requires_zero_review_pages": false
  },
  "output_mode": "pages_and_surahs"
}
